<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD Suppressions 1.1//EN"
    "https://checkstyle.org/dtds/suppressions_1_1.dtd">

<suppressions>
    <!-- Suppress rules that do not align with existing codebase conventions -->
    <suppress checks="NeedBraces" files=".*"/>
    <suppress checks="MissingJavadocType" files=".*"/>
    <suppress checks="MissingJavadocMethod" files=".*"/>
    <suppress checks="JavadocVariable" files=".*"/>
    <suppress checks="AvoidStarImport" files=".*"/>
    <suppress checks="LocalVariableName" files=".*"/>
    <suppress checks="ParameterName" files=".*"/>
    <suppress checks="MemberName" files=".*"/>
    <suppress checks="ConstantName" files=".*"/>
    <suppress checks="StaticVariableName" files=".*"/>
    <suppress checks="AbbreviationAsWordInName" files=".*"/>
    <suppress checks="VariableDeclarationUsageDistance" files=".*"/>
    <suppress checks="EmptyCatchBlock" files=".*"/>
    <suppress checks="OverloadMethodsDeclarationOrder" files=".*"/>
</suppressions>
